{
  "manifest_version": 3,
  "name": "MailMate — AI Email Assistant",
  "version": "1.0.0",
  "description": "Generate smart email replies powered by AI. Click the ✨ button in Gmail to instantly draft a reply.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://dreamy-swimwear-daffodil.ngrok-free.dev/*",
    "http://vs224.dei.isep.ipp.pt:2224/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
