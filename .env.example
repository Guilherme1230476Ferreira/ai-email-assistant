# ==============================================================================
# AI Email Assistant — Environment Variables
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ==============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ai_email_assistant
DATABASE_URL=postgresql://postgres:change-me-strong-password@db:5432/ai_email_assistant

# ─── LLM API Keys ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# ─── Security ───────────────────────────────────────────────────
JWT_SECRET=change-me-random-secret-at-least-32-chars

# ─── Server ─────────────────────────────────────────────────────
PORT=3000
